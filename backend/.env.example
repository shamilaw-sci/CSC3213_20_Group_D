NODE_ENV=development
PORT=5000

# PostgreSQL
# Render may provide a single DATABASE_URL instead of the individual DB_* names.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=care4u_db
DB_USER=postgres
DB_PASSWORD=your_pg_password_here


# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Gmail SMTP via Nodemailer) — EMAIL_USER must have 2-Step
# Verification enabled with an App Password generated for EMAIL_PASS
# (not your regular Gmail password). See: myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password

# Google Gemini API Key for AI Features
GEMINI_API_KEY=your_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional Telegram emergency notification channel
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session secret used to sign the session ID cookie — use a long random string in production
SESSION_SECRET=replace_this_with_a_long_random_string
# Session cookie max age in milliseconds (default: 86400000 = 24 hours)
SESSION_MAX_AGE_MS=86400000

# Development-only auth/consent code logging. Keep false in production.
SHOW_AUTH_CODES_IN_CONSOLE=false

# Request IP trust: default 0 outside production, 1 in production. Set only for
# a verified proxy topology with restricted direct access (never trust all).
# TRUST_PROXY_HOPS=0

# OTP/recovery limits per process. All attempts count, including invalid input.
# Registration/resend/forgot-password share the two email-generation budgets.
AUTH_RATE_WINDOW_MS=900000
AUTH_EMAIL_IP_LIMIT=20
AUTH_EMAIL_ADDRESS_LIMIT=5
AUTH_VERIFY_IP_LIMIT=30
AUTH_VERIFY_EMAIL_LIMIT=10
AUTH_RESET_IP_LIMIT=30
AUTH_RESET_TOKEN_LIMIT=5

# Production PostgreSQL verifies TLS. If the provider CA is not in system trust,
# set DB_SSL_CA to the trusted PEM certificate (literal \n sequences are accepted).
# DB_SSL_CA=-----BEGIN CERTIFICATE-----...
