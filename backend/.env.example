
# ==========================================
# Care4U Backend Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=5000

# PostgreSQL Database
# Use DATABASE_URL for a hosted database,
# or configure the individual DB_* variables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=care4u_db
DB_USER=postgres
DB_PASSWORD=your_database_password

# Session Configuration
# Use a long, randomly generated secret.
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_MAX_AGE_MS=86400000

# Frontend and CORS
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email Configuration (Gmail / Nodemailer)
# Use a Google App Password, not your Gmail password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password

# AI Services
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Telegram Emergency Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Authentication
# Keep false in production.
SHOW_AUTH_CODES_IN_CONSOLE=false

# Authentication Rate Limits
AUTH_RATE_WINDOW_MS=900000
AUTH_EMAIL_IP_LIMIT=20
AUTH_EMAIL_ADDRESS_LIMIT=5
AUTH_VERIFY_IP_LIMIT=30
AUTH_VERIFY_EMAIL_LIMIT=10
AUTH_RESET_IP_LIMIT=30
AUTH_RESET_TOKEN_LIMIT=5

# Proxy Configuration (Optional)
# Default is 0 in development and 1 in production.
# TRUST_PROXY_HOPS=0

# Database TLS (Optional)
# Supply a trusted CA certificate when required.
# DB_SSL_CA=
