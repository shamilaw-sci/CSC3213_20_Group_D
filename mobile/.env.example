# Your computer's local network IP address (find via `ipconfig` on Windows
# or `ifconfig`/`ip addr` on Mac/Linux). Your phone and computer must be
# on the same Wi-Fi network. Each teammate sets their own value here -
# never commit your real IP in api.js itself.
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:5000

# The mobile SOS dialer uses the documented 1990 Suwa Seriya number.
