# Backend API URL
#
# Local development:
# Replace YOUR_LOCAL_IP with your computer's LAN IP.
# The phone and computer must be on the same network.
#
# Production:
# Use the deployed Render HTTPS backend URL.
#
# Do not include /api at the end.

EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:5000
